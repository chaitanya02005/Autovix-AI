# Local development defaults. Keep real credentials in the ignored .env file.
AUTOVIX_ENV=development
AUTOVIX_API_SECRET=
AUTOVIX_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AUTOVIX_BOOTSTRAP_ADMIN_PASSWORD=

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.1

CHUNK_SIZE=1000
CHUNK_OVERLAP=120
# TESSERACT_CMD=
